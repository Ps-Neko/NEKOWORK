{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ps-Neko/NEKOWORK/main/schemas/handoff.schema.json",
  "title": "Handoff JSON",
  "description": "단계 간 구조화된 핸드오프. 마크다운 5필드와 별도로 JSON 첨부 가능.",
  "type": "object",
  "required": ["stage", "agent", "decided", "files"],
  "additionalProperties": false,
  "properties": {
    "stage": {
      "enum": ["question-gate", "ideate", "plan", "implement", "self-review", "codex-review", "codex-challenge", "ship"]
    },
    "agent": { "type": "string" },
    "round": { "type": "integer", "minimum": 1 },
    "session_id": { "type": "string" },
    "team_stage": {
      "type": "string",
      "pattern": "^team-[a-z0-9-]+$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "provider": { "enum": ["mock", "claude", "codex", "gemini", "local"] },
    "model": { "type": "string" },
    "decided": { "type": "string", "minLength": 1 },
    "rejected": { "type": "string" },
    "risks": { "type": "string" },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remaining": { "type": "string" },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/Issue" }
    },
    "verdict": {
      "enum": ["block", "approve_with_fixes", "approve"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_level": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "desc"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "desc": { "type": "string", "minLength": 1 },
          "passes": { "type": "boolean" },
          "source": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requires_human_gate": {
      "type": "boolean"
    },
    "prdSeed": {
      "type": "object",
      "additionalProperties": true
    },
    "diffPath": {
      "type": "string"
    },
    "executionWorkspace": {
      "type": "string"
    }
  },
  "$defs": {
    "Issue": {
      "type": "object",
      "required": ["severity", "category", "summary"],
      "additionalProperties": false,
      "properties": {
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "category": { "enum": ["security", "correctness", "performance", "style", "test", "docs"] },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "claim": { "type": "string" },
        "evidence": { "type": "string" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "why": { "type": "string" },
        "required_fix": { "type": ["string", "null"] },
        "suggested_fix": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "gate_required": { "type": "boolean" }
      }
    }
  }
}

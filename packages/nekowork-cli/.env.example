# HARNESS 환경 변수 (모두 선택 사항, 기본값으로 동작)

# 비용·예산
HARNESS_DAILY_COST_CAP_USD=10.0
HARNESS_DRY_RUN=0

# Codex 통합
HARNESS_CODEX_CLI=codex
HARNESS_CODEX_PROFILE=review
HARNESS_CODEX_TIMEOUT_S=180

# 검증 게이트
HARNESS_REVIEW_ROUND_LIMIT=3
HARNESS_HUMAN_GATE_ON_CRITICAL=1
HARNESS_HUMAN_GATE_ON_BLAST_RADIUS=20

# 훅 토글
HARNESS_HOOK_GATEGUARD=1
HARNESS_HOOK_QUALITY_GATE=1
HARNESS_HOOK_PERSISTENT_MODE=1
HARNESS_HOOK_PRE_BASH=1

# 로그
HARNESS_LOG_LEVEL=info
HARNESS_AUDIT_DIR=.harness/audit

# ──────────────────────────────────────────────────────────────────────
# 인증 (auth) — 자세한 정책은 docs/AUTH-MIGRATION.md
# ──────────────────────────────────────────────────────────────────────
#
# LLM provider (Claude / Codex / Gemini) API key 는 .env 에 두지 마세요.
# 구독 OAuth 세션을 CLI 에 위임합니다:
#   claude login                            # Claude Pro / Max 구독자
#   codex auth login                        # ChatGPT 로그인 세션
#   gcloud auth application-default login   # Gemini / Vertex
#
# .bashrc 등에 ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY /
# GOOGLE_API_KEY 가 set 되어 있으면 pre-bash-dispatcher 가 차단합니다
# (구독 OAuth 가 무시되어 종량제 과금으로 빠지는 사고 방지).
# 종량제 사용을 명시 옵트아웃하려면:
#   HARNESS_AUTH_ALLOW_ENV_OVERRIDE=1

# GitHub — OAuth Device Flow (권장)
#   npm run auth:github:login  → ~/.harness/oauth/github.json 에 토큰 저장.
#   사전 등록 필요:
#   1) https://github.com/settings/developers → New OAuth App
#   2) "Enable Device Flow" 체크
#   3) HARNESS_GITHUB_CLIENT_ID 에 client_id 등록
HARNESS_GITHUB_CLIENT_ID=

# GITHUB_TOKEN: fallback (PAT). CI 등 OAuth 가 어려운 환경에서만 사용.
# 가능하면 위 OAuth Device Flow 권장.
GITHUB_TOKEN=

# Exa / Context7 — vault 권장 (~/.harness/oauth/<provider>.json).
# .env 슬롯은 CI 등 vault 를 쓸 수 없는 환경에서만 임시로.
CONTEXT7_API_KEY=
EXA_API_KEY=

# 사내 RAG 브릿지 (옵션, iljin-rag-poc 결합 시)
HARNESS_RAG_ENDPOINT=
HARNESS_RAG_API_KEY=
